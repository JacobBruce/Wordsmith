[Desktop Entry]
Version=1.0
Type=Application
Name=Wordsmith Text Editor
GenericName=Wordsmith
Comment=Text editor for writers and speed typists
Exec=wordsmith %F
Icon=wordsmith
Terminal=false
MimeType=text/plain;text/markdown;text/html;text/x-markdown;
StartupWMClass=wordsmith
Categories=Utility;Office;GTK;
Keywords=text-editor;spell-check;dictionary;writing;markdown
StartupNotify=true
